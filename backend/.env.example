NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:12345678@localhost:5432/madrasha_edumanage
DATABASE_SSL=false
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@school.edu
ADMIN_PASSWORD=Admin@123

# Public URL of the web app (used in QR codes, reset links and payment returns)
PUBLIC_APP_URL=http://localhost:3000
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
BACKUP_DIR=backups
WORKER_ENABLED=true

# SMS gateway (BTRC-approved provider). Leave empty to keep messages queued.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Push notifications (Firebase Cloud Messaging legacy server key)
FCM_SERVER_KEY=

# Payment gateways. Callbacks must be signed with HMAC-SHA256(PAYMENT_CALLBACK_SECRET) in X-Signature.
PAYMENT_CALLBACK_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
BKASH_BASE_URL=
NAGAD_BASE_URL=

# GPS trackers send X-GPS-Key with each position
GPS_SHARED_KEY=
