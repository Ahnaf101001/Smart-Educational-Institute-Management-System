NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:12345678@localhost:5432/madrasha_edumanage
DATABASE_SSL=false
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@school.edu
ADMIN_PASSWORD=Admin@123

# Public URL of the web app (used in QR codes, reset links and payment returns)
PUBLIC_APP_URL=http://localhost:3000
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
BACKUP_DIR=backups
WORKER_ENABLED=true

# SMS gateway (BTRC-approved provider). Leave empty to keep messages queued.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Push notifications (Firebase Cloud Messaging legacy server key)
FCM_SERVER_KEY=

# Payment gateways. Callbacks must be signed with HMAC-SHA256(PAYMENT_CALLBACK_SECRET) in X-Signature.
PAYMENT_CALLBACK_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# bKash Tokenized Checkout (sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta)
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Nagad Remote Payment Gateway (sandbox: http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0)
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
# PEM or base64 body; Nagad public key and your merchant private key
NAGAD_PUBLIC_KEY=
NAGAD_MERCHANT_PRIVATE_KEY=
# Public IP sent to Nagad in X-KM-IP-V4 (must be whitelisted by Nagad)
SERVER_PUBLIC_IP=

# WhatsApp Business Cloud API (optional notice/receipt channel)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# AES-256 key for sensitive fields at rest (NID). Generate once, back it up, never change it.
DATA_ENCRYPTION_KEY=

# Which proxies may set X-Forwarded-For (default loopback = Next.js/nginx on this machine)
TRUST_PROXY=loopback

# GPS trackers send X-GPS-Key with each position
GPS_SHARED_KEY=
